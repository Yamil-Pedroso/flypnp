{
  "compilerOptions": {
    "types": ["node"],
    "target": "es2020",
    "module": "Node16",
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Node16",
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude":[
    "./node_modules"
  ]
}
